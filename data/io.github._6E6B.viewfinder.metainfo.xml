<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github._6E6B.viewfinder</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Viewfinder</name>
  <summary>Browse photos and conversations</summary>
  <developer id="io.github._6E6B">
    <name>Nick</name>
  </developer>
  <description>
    <p>
      Viewfinder is an independent native desktop client for browsing photos,
      short videos, stories, and conversations from a popular photo-sharing
      service. It is not affiliated with Meta Platforms, Inc.
    </p>
    <p>You can:</p>
    <ul>
      <li>Sign in through an embedded login window and store the session in the system keyring</li>
      <li>Browse your feed, profiles, Reels, Stories, inbox, and notifications</li>
      <li>Search for accounts and posts, and like, follow, or comment from the native interface</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/6E6B/viewfinder</url>
  <url type="bugtracker">https://github.com/6E6B/viewfinder/issues</url>
  <url type="vcs-browser">https://github.com/6E6B/viewfinder</url>
  <launchable type="desktop-id">io.github._6E6B.viewfinder.desktop</launchable>
  <provides>
    <binary>viewfinder</binary>
  </provides>
  <branding>
    <color type="primary" scheme_preference="light">#ed333b</color>
    <color type="primary" scheme_preference="dark">#241f31</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>A profile in Viewfinder</caption>
      <image>https://raw.githubusercontent.com/6E6B/viewfinder/v0.1.0/profile.png</image>
    </screenshot>
    <screenshot>
      <caption>Reels in Viewfinder</caption>
      <image>https://raw.githubusercontent.com/6E6B/viewfinder/v0.1.0/reels.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.1.0" date="2026-09-09">
      <description>
        <p>Initial packaged release with native browsing, messaging, and desktop integration.</p>
      </description>
    </release>
  </releases>
</component>
